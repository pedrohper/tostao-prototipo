# Copie para apps/api/.env e preencha. NUNCA commite o .env (o repo é público).
DATABASE_URL="postgresql://tostao:tostao@localhost:5432/tostao?schema=public"
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria"
PORT=3333
WEB_ORIGIN="http://localhost:3000"

# "fake" usa dados de exemplo; "pluggy" usa sua conta real do Meu Pluggy
BANK_GATEWAY="fake"
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Horário da sincronização diária (cron, fuso de São Paulo)
SYNC_CRON="0 6 * * *"
