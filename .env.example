# Copie para apps/api/.env e preencha. NUNCA commite o .env (o repo é público).
DATABASE_URL="postgresql://tostao:tostao@localhost:5432/tostao?schema=public"
# Assina o access token (15 min). Em produção: 32+ caracteres, senão a API nem sobe. Gere com: openssl rand -hex 32
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria"
PORT=3333
# Origem(ns) do site, separadas por vírgula. Em produção: HTTPS e nunca "*" (o CORS usa credentials).
WEB_ORIGIN="http://localhost:3000"
# Quais proxies são de confiança pra ler o X-Forwarded-For (IP real nos limites de requisição). A web fica na mesma
# máquina e repassa o IP do cliente: "loopback" confia só nela. Aceita "false" ou lista de IPs/CIDRs (127.0.0.1,172.18.0.0/16).
TRUST_PROXY="loopback"

# Redis: state do login social (uso único, 5 min) e limite de tentativas do vínculo do WhatsApp. OBRIGATÓRIO (fora de NODE_ENV=test).
# Dev: `pnpm db:up` já sobe o Redis do docker-compose. Se o Redis for compartilhado com outros serviços, use um banco só do Tostão (…/5).
REDIS_URL="redis://localhost:6379/0"

# E-mail transacional (verificação de e-mail e "esqueci minha senha").
# "resend" envia de verdade (https://resend.com): crie a chave e verifique o domínio do remetente.
# "fake" só em development/test: não envia nada e imprime o link no console da API (com NODE_ENV de produção a API recusa subir).
# Os links nos e-mails usam o WEB_ORIGIN acima.
EMAIL_PROVIDER="fake"
RESEND_API_KEY=""
EMAIL_FROM="Tostão <nao-responda@seudominio.com.br>"

# "fake" usa dados de exemplo; "pluggy" usa sua conta real do Meu Pluggy
BANK_GATEWAY="fake"
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Conectores sandbox no widget. Vazio = só fora de produção. Em produção, deixe "false" ou vazio.
PLUGGY_INCLUDE_SANDBOX=""

# Horário da sincronização diária (cron, fuso de São Paulo)
SYNC_CRON="0 6 * * *"
# Lançamentos automáticos (recorrências/parcelas) e agendados que chegaram na data (T5.2). Padrão: toda hora, no minuto 5.
# RECURRING_CRON="5 * * * *"

# Web Push (gere as chaves com: pnpm --filter @tostao/api vapid). Contato obrigatório se usar push.
VAPID_SUBJECT="mailto:voce@exemplo.com"

# WhatsApp Cloud API oficial da Meta (preencha para ligar sem n8n/Evolution)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_NUMBER=""
WHISPER_URL="http://127.0.0.1:8000/v1/audio/transcriptions"

# Login social (Google e Apple). Vazio = provedor desligado.
# Callbacks: ${WEB_ORIGIN}/api/auth/google/callback e ${WEB_ORIGIN}/api/auth/apple/callback
# Em produção, WEB_ORIGIN tem que ser a origem pública em HTTPS (igual a APP_PUBLIC_URL da web): a redirect_uri é conferida de forma exata.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
