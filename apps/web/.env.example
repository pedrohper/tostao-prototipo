# Copie para apps/web/.env.local
API_URL="http://localhost:3333"

# --- Login social (Google/Apple) ---
# Origem pública do site, em HTTPS. OBRIGATÓRIA em produção: a redirect_uri do login social é montada a partir daqui
# (e não do cabeçalho Host/x-forwarded-host, que quem faz a requisição controla). Deve ser igual ao WEB_ORIGIN da API.
# Em desenvolvimento pode ficar vazia (usa o host da requisição).
APP_PUBLIC_URL=""
# Segredo (32+ caracteres) que assina o cookie do login social. OBRIGATÓRIO em produção; sem ele o login social fica desligado.
# Gere com: openssl rand -hex 32
OAUTH_COOKIE_SECRET=""

# --- Sessão ---
# A API devolve um access token de 15 min e um refresh token de 30 dias; o site guarda os dois em cookies httpOnly
# (tostao_token e tostao_refresh) e renova sozinho. Nenhuma variável nova: em produção o cookie é "secure", então
# o acesso precisa ser por HTTPS. APP_PUBLIC_URL (acima) também é a base dos redirects de logout/sessão vencida.
# Os e-mails de "esqueci minha senha" e de verificação apontam pra {WEB_ORIGIN da API}/redefinir-senha e /verificar-email.

# --- Idiomas ---
# Lançamento comercial só em PT-BR: com false (padrão) o seletor EN/ES some da tela de preferências e o site só carrega o
# dicionário PT-BR no navegador. NEXT_PUBLIC_* é fixado na hora do `pnpm build` (mudou? rebuilda).
# Reativar EN/ES exige migrar os Client Components pra receber o dicionário por provider (ver lib/i18n-flag.ts).
NEXT_PUBLIC_ENABLE_I18N=false

# --- Dados do responsável (Termos, Privacidade, rodapé de ajuda) ---
# Aparecem nos textos legais e na faixa de ajuda do app. NEXT_PUBLIC_* é fixado na hora do `pnpm build`: mudou? rebuilda.
# Sem valor, nada é inventado: o e-mail some (o texto fala em "canal de suporte"), a razão social vira só "Tostão" e o
# CNPJ não aparece. PREENCHA TUDO antes de abrir o app pra mais gente (a LGPD exige um canal e um encarregado de dados).
# Use um endereço do domínio do negócio, nunca um e-mail pessoal.
# E-mail de suporte (ex.: suporte@seudominio.com.br).
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Encarregado pelo tratamento de dados pessoais, o DPO (LGPD art. 41). Vazio = usa o e-mail de suporte.
NEXT_PUBLIC_DPO_EMAIL=""
# Razão social de quem opera o app (ex.: Tostão Tecnologia Ltda.). Vazio = "Tostão".
NEXT_PUBLIC_LEGAL_ENTITY=""
# CNPJ, com ou sem pontuação. Só aparece se os dígitos verificadores baterem.
NEXT_PUBLIC_LEGAL_CNPJ=""

# Atalhos do iPhone (/mais/atalhos). Links de compartilhamento do iCloud dos Atalhos PRONTOS (opcional: só aceita
# https://www.icloud.com/shortcuts/...). Sem eles, a tela ensina a montar o Atalho com a URL, o cabeçalho e o JSON.
# Lidas em runtime (não precisa rebuildar).
SHORTCUT_APPLE_PAY_URL=""
SHORTCUT_NOTIFICATION_URL=""
