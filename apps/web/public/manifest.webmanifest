{
  "name": "Tostão",
  "short_name": "Tostão",
  "description": "Grana explicada, de tostão em tostão.",
  "start_url": "/inicio",
  "display": "standalone",
  "background_color": "#FDFBF6",
  "theme_color": "#FDFBF6",
  "icons": [
    {
      "src": "/icones/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icones/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icones/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".ofx",
            ".csv",
            ".pdf",
            "application/pdf",
            "application/x-ofx",
            "application/ofx",
            "text/csv",
            "text/plain",
            "image/*"
          ]
        }
      ]
    }
  }
}
