// Modelo de dados do Tostão.
// Dinheiro SEMPRE em centavos (Int): nada de float pra grana.
// Negativo = saiu da conta, positivo = entrou.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  connections  BankConnection[]
  accounts     Account[]
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      CategoryBudget[]
  lessons      LessonProgress[]
  invitesSent  Invite[]        @relation("InvitesSent")
  inviteUsed   Invite?         @relation("InviteUsed")
  tribunalVotes TribunalVote[]
  battles      Battle[]
  passwordResets PasswordReset[]
  chatMessages   ChatMessage[]
  ignoredSubscriptions IgnoredSubscription[]
  categories   Category[]
  plan         FinancialPlan?
  whatsapp     WhatsappLink?
  activities   UserActivity[]
  friendCode   FriendCode?
  friendships  Friendship[]    @relation("FriendOf")
  friendOf     Friendship[]    @relation("FriendIs")
  pushSubscriptions PushSubscription[]
  sentNotifications SentNotification[]

  @@map("users")
}

// Uma conexão = um "Item" do Pluggy (um banco autorizado no Meu Pluggy)
model BankConnection {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  itemId       String    @map("item_id")
  institution  String?
  status       String    @default("ACTIVE") // ACTIVE | ERROR
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([userId, itemId])
  @@map("bank_connections")
}

model Account {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  connectionId   String  @map("connection_id")
  externalId     String  @map("external_id")
  name           String
  type           String  // BANK | CREDIT
  balanceInCents Int     @map("balance_in_cents")
  fingerprint    String? // cartão: "CREDIT:BANDEIRA:final", pra achar o mesmo cartão em duas conexões
  hidden         Boolean @default(false) // a pessoa ocultou (ex.: poupança que não usa). O sync nunca mexe nisso.
  creditLimitInCents Int?      @map("credit_limit_in_cents") // cartão: limite total
  dueDate            DateTime? @map("due_date") // cartão: vencimento da fatura atual

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, externalId])
  @@index([userId, fingerprint])
  @@map("accounts")
}

// Categorias são globais (seed). Usuário escolhe entre elas.
model Category {
  id    String @id // slug: "delivery", "mercado"...
  name  String
  emoji String
  color String
  kind   String  @default("saida") // saida | entrada | neutra (não conta)
  userId String? @map("user_id") // null = do sistema; preenchido = categoria criada pela pessoa

  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      CategoryBudget[]

  @@map("categories")
}

// "Toda vez que aparecer IFD* põe em Delivery"
// userId null = regra padrão do sistema
model CategoryRule {
  id         String  @id @default(uuid())
  userId     String? @map("user_id")
  pattern    String  // trecho em MAIÚSCULAS procurado na descrição
  categoryId String  @map("category_id")

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, pattern])
  @@map("category_rules")
}

model Transaction {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  accountId          String?  @map("account_id") // null = anotado na mão
  externalId         String?  @map("external_id") // id do Pluggy, pra não importar duas vezes
  description        String
  amountInCents      Int      @map("amount_in_cents")
  occurredAt         DateTime @map("occurred_at")
  categoryId         String?  @map("category_id")
  isInternalTransfer Boolean  @default(false) @map("is_internal_transfer")
  createdAt          DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([userId, externalId])
  @@index([userId, occurredAt])
  @@map("transactions")
}

// "No máximo R$ 300 em delivery por mês"
model CategoryBudget {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  categoryId   String @map("category_id")
  limitInCents Int    @map("limit_in_cents")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
  @@map("category_budgets")
}

// Lição concluída (id da lição vem do JSON do currículo, ex.: "m1-l2")
model LessonProgress {
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

// "Isso não é assinatura": a chave é a mesma que o detector usa pra agrupar (ex.: "CENTAURO")
model IgnoredSubscription {
  userId String @map("user_id")
  key    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("ignored_subscriptions")
}

// Convite: cadastro só entra com código (menos a primeira conta do servidor).
model Invite {
  code        String    @id
  createdById String    @map("created_by_id")
  usedById    String?   @unique @map("used_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  usedAt      DateTime? @map("used_at")

  createdBy User  @relation("InvitesSent", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("invites")
}

// Link de "esqueci a senha". Guardamos só o hash do token; o link vale 1 h e uma vez.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// Conversa com o Tostão (app e, depois, WhatsApp).
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      String   // user | assistant
  content   String
  channel   String   @default("app") // app | whatsapp
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

// Renda, outras entradas, contas fixas e objetivo (o onboarding pergunta). JSON validado pelo contrato.
model FinancialPlan {
  userId    String   @id @map("user_id")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_plans")
}

// WhatsApp do Tostão: o número fica ligado à conta depois que a pessoa manda o código gerado no app.
model WhatsappLink {
  userId        String    @id @map("user_id")
  phone         String?   @unique
  code          String?   @unique
  codeExpiresAt DateTime? @map("code_expires_at")
  linkedAt      DateTime? @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_links")
}

// Tribunal do Tostão: um voto por pessoa por caso da semana
model TribunalVote {
  userId  String   @map("user_id")
  caseId  String   @map("case_id")
  choice  Int
  votedAt DateTime @default(now()) @map("voted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, caseId])
  @@index([caseId])
  @@map("tribunal_votes")
}

// Batalha contra um vilão: Tigrinho (30 dias sem bet, conferido no extrato) e Urubu do Pix (checklist)
model Battle {
  userId    String    @map("user_id")
  kind      String
  status    String
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  steps     String[]  @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("battles")
}

/// Missão feita num dia (Brasília). Uma linha por tipo por dia: a ofensiva conta dias com pelo menos uma.
model UserActivity {
  userId String   @map("user_id")
  day    String
  kind   String
  at     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, kind])
  @@map("user_activities")
}

/// Código que a pessoa passa pros amigos (TOST-XXXX).
model FriendCode {
  userId String @id @map("user_id")
  code   String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("friend_codes")
}

/// Amizade guardada nos dois sentidos (A→B e B→A).
model Friendship {
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("FriendOf", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendIs", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@map("friendships")
}

model PushSubscription {
  endpoint  String   @id
  userId    String   @map("user_id")
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Aviso que já foi mandado (pra não repetir).
model SentNotification {
  userId String   @map("user_id")
  key    String
  sentAt DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("sent_notifications")
}
