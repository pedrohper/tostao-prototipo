// Modelo de dados do Tostão.
// Dinheiro SEMPRE em centavos (BigInt no banco: cabe além dos R$ 21 milhões do Int de 32 bits): nada de float pra grana.
// Os repositórios convertem pra number (seguro até Number.MAX_SAFE_INTEGER) na borda; o resto do app só vê number.
// Negativo = saiu da conta, positivo = entrou.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  // Fuso da pessoa (IANA). Dia civil, fechamento de mês e lembretes usam isto (default: Brasília).
  timezone        String    @default("America/Sao_Paulo")
  // Quando provamos que a pessoa controla o e-mail (hoje: cadastro por Google/Apple com e-mail verificado).
  // Cadastro por senha NÃO preenche: sem isso, um login social nunca é vinculado a uma conta de senha (pre-takeover).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  // Aceite dos Termos/Privacidade no cadastro por senha (versão do texto aceito). Expande pra UserConsent na Fase 1.
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion    String?   @map("terms_version")
  // Consentimento explícito pra mandar dados (mascarados) pra IA (LGPD). null = não aceitou: IA bloqueada.
  aiConsentAt     DateTime? @map("ai_consent_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  oauthAccounts           OAuthAccount[]
  connections             BankConnection[]
  accounts                Account[]
  transactions            Transaction[]
  people                  Person[]
  reconciledNotes         ReconciledNote[]
  rules                   CategoryRule[]
  budgets                 CategoryBudget[]
  lessons                 LessonProgress[]
  invitesSent             Invite[]                 @relation("InvitesSent")
  inviteUsed              Invite?                  @relation("InviteUsed")
  tribunalVotes           TribunalVote[]
  battles                 Battle[]
  passwordResets          PasswordReset[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  consents                UserConsent[]
  auditLogs               AuditLog[]
  chatMessages            ChatMessage[]
  ignoredSubscriptions    IgnoredSubscription[]
  categories              Category[]
  plan                    FinancialPlan?
  whatsapp                WhatsappLink?
  activities              UserActivity[]
  friendCode              FriendCode?
  friendships             Friendship[]             @relation("FriendOf")
  friendOf                Friendship[]             @relation("FriendIs")
  pushSubscriptions       PushSubscription[]
  sentNotifications       SentNotification[]
  tostaoInsights          TostaoInsight[]
  tostaoAutoConfig        TostaoAutoConfig?

  @@map("users")
}

// Conta social ligada ao usuário (Google ou Apple). Uma pessoa pode ter mais de um provedor.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  email             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Uma conexão = um "Item" do Pluggy (um banco autorizado no Meu Pluggy)
model BankConnection {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  itemId       String           @map("item_id")
  institution  String?
  status       ConnectionStatus @default(ACTIVE)
  lastSyncedAt DateTime?        @map("last_synced_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([userId, itemId])
  // + índice único parcial em item_id (Open Finance, fora import:/manual:) criado por SQL na migration
  // 20261120120000_bank_connections_item_unique: o Prisma não modela índice parcial.
  @@map("bank_connections")
}

model Account {
  id                 String      @id @default(uuid())
  userId             String      @map("user_id")
  connectionId       String      @map("connection_id")
  externalId         String      @map("external_id")
  name               String
  type               AccountType
  balanceInCents     BigInt      @map("balance_in_cents")
  fingerprint        String? // cartão: "CREDIT:BANDEIRA:final", pra achar o mesmo cartão em duas conexões
  currency           String      @default("BRL")
  hidden             Boolean     @default(false) // a pessoa ocultou (ex.: poupança que não usa). O sync nunca mexe nisso.
  creditLimitInCents BigInt?     @map("credit_limit_in_cents") // cartão: limite total
  dueDate            DateTime?   @map("due_date") @db.Timestamptz(3) // cartão: vencimento da fatura atual

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, externalId])
  @@index([userId, fingerprint])
  @@map("accounts")
}

// Categorias são globais (seed). Usuário escolhe entre elas.
model Category {
  id     String       @id // slug: "delivery", "mercado"...
  name   String
  emoji  String
  color  String
  kind   CategoryKind @default(saida) // saida | entrada | neutra (não conta)
  userId String?      @map("user_id") // null = do sistema; preenchido = categoria criada pela pessoa

  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      CategoryBudget[]

  @@map("categories")
}

// "Toda vez que aparecer IFD* põe em Delivery"
// userId null = regra padrão do sistema
model CategoryRule {
  id         String  @id @default(uuid())
  userId     String? @map("user_id")
  pattern    String // trecho em MAIÚSCULAS procurado na descrição
  categoryId String  @map("category_id")

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@map("category_rules")
}

model Transaction {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  accountId          String?  @map("account_id") // null = anotado na mão
  externalId         String?  @map("external_id") // id do Pluggy, pra não importar duas vezes
  description        String
  amountInCents      BigInt   @map("amount_in_cents")
  currency           String   @default("BRL")
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  categoryId         String?  @map("category_id")
  isInternalTransfer Boolean  @default(false) @map("is_internal_transfer")
  // Anotado com "todo mês" ou "parcelado": as próximas já ficam lançadas nos meses seguintes, com o mesmo seriesId.
  seriesId           String?  @map("series_id")
  // Acerto com alguém (emprestei o cartão, emprestei/peguei grana, me pagou): não é gasto nem renda.
  personId           String?  @map("person_id")
  // Anotação livre da pessoa ("pago pro João, devolve dia 10"). Pode existir mesmo em transação do banco.
  note               String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: desconectar o banco apaga só os lançamentos do banco (DisconnectBankUseCase); os manuais ficam com accountId nulo.
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id])
  person   Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId])
  @@index([userId, occurredAt])
  @@index([seriesId])
  @@index([personId])
  @@map("transactions")
}

// Caderninho de acertos: quem te deve e pra quem você deve.
model Person {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@map("people")
}

// "No máximo R$ 300 em delivery por mês"
model CategoryBudget {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  categoryId   String @map("category_id")
  limitInCents BigInt @map("limit_in_cents")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("category_budgets")
}

// Lição concluída (id da lição vem do JSON do currículo, ex.: "m1-l2")
model LessonProgress {
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

// "Isso não é assinatura": a chave é a mesma que o detector usa pra agrupar (ex.: "CENTAURO")
model IgnoredSubscription {
  userId String @map("user_id")
  key    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("ignored_subscriptions")
}

// Convite: cadastro só entra com código (menos a primeira conta do servidor).
model Invite {
  code        String    @id
  createdById String?   @map("created_by_id")
  usedById    String?   @unique @map("used_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)

  createdBy User? @relation("InvitesSent", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User? @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("invites")
}

// Link de "esqueci a senha". Guardamos só o hash do token; o link vale 1 h e uma vez.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// Sessão revogável: o access token (JWT) dura 15 min; este token opaco (30 dias) só serve pra trocar por um par novo.
// Guardamos só o SHA-256. Cada troca (rotação) revoga o anterior e herda o familyId; reapresentar um token já
// revogado indica roubo/replay e revoga a família inteira.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Prova de que a pessoa controla o e-mail do cadastro. Só o hash do token (256 bits, 24 h, uso único).
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Histórico de consentimentos (LGPD): cada aceite/revogação vira uma linha. users.terms_accepted_at e
// users.ai_consent_at seguem como o "estado atual" que o app consulta; esta tabela é o registro com versão e data.
model UserConsent {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String // terms | privacy | ai
  version   String
  grantedAt DateTime  @map("granted_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_consents")
}

// Trilha de auditoria de eventos de segurança. userId vira NULL (SetNull) se a conta for apagada: o evento fica, a pessoa não.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // password_reset | account_deleted | consent_changed | refresh_reuse_detected
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Tarefa a refazer fora do pedido do usuário (ex.: desligar o Item no Pluggy depois de apagar a conta, quando o
// provedor estava fora do ar). Não tem FK pra users: precisa sobreviver à exclusão da pessoa.
model OutboxJob {
  id          String       @id @default(uuid())
  type        String // pluggy.deleteItem
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(8) @map("max_attempts")
  runAt       DateTime     @default(now()) @map("run_at") @db.Timestamptz(3)
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("outbox_jobs")
}

// Conversa com o Tostão (app e, depois, WhatsApp).
model ChatMessage {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  role      ChatRole
  content   String
  channel   ChatChannel @default(app)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

// Renda, outras entradas, contas fixas e objetivo (o onboarding pergunta). JSON validado pelo contrato.
model FinancialPlan {
  userId    String   @id @map("user_id")
  data      Json
  // Lock otimista: cada gravação confere e incrementa. Duas escritas simultâneas não perdem uma a outra.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_plans")
}

// WhatsApp do Tostão: o número fica ligado à conta depois que a pessoa manda o código gerado no app.
model WhatsappLink {
  userId        String    @id @map("user_id")
  phone         String?   @unique
  // SHA-256 do código "TOST-XXXXXXXXXXXX". O código em si nunca fica no banco.
  codeHash      String?   @unique @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at") @db.Timestamptz(3)
  linkedAt      DateTime? @map("linked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_links")
}

// Tribunal do Tostão: um voto por pessoa por caso da semana
model TribunalVote {
  userId  String   @map("user_id")
  caseId  String   @map("case_id")
  choice  Int
  votedAt DateTime @default(now()) @map("voted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, caseId])
  @@index([caseId])
  @@map("tribunal_votes")
}

// Batalha contra um vilão: Tigrinho (30 dias sem bet, conferido no extrato) e Urubu do Pix (checklist)
model Battle {
  userId    String       @map("user_id")
  kind      BattleKind
  status    BattleStatus
  startedAt DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?    @map("ended_at") @db.Timestamptz(3)
  steps     String[]     @default([])
  // Lock otimista (ver FinancialPlan.version).
  version   Int          @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("battles")
}

/// Missão feita num dia (Brasília). Uma linha por tipo por dia: a ofensiva conta dias com pelo menos uma.
model UserActivity {
  userId String   @map("user_id")
  day    DateTime @db.Date
  kind   String
  at     DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, kind])
  @@map("user_activities")
}

/// Código que a pessoa passa pros amigos (TOST-XXXX).
model FriendCode {
  userId String @id @map("user_id")
  code   String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("friend_codes")
}

/// Amizade guardada nos dois sentidos (A→B e B→A).
model Friendship {
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User @relation("FriendOf", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendIs", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@map("friendships")
}

model PushSubscription {
  endpoint  String   @id
  userId    String   @map("user_id")
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Aviso que já foi mandado (pra não repetir).
model SentNotification {
  userId String   @map("user_id")
  key    String
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("sent_notifications")
}

/// Achados automáticos do Tostão e do Caramelo pro usuário agir em 1 toque.
model TostaoInsight {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  routine   String
  kind      String
  severity  InsightSeverity @default(info)
  title     String
  body      String
  payload   Json
  dedupeKey String          @map("dedupe_key")
  status    InsightStatus   @default(PENDING)
  expiresAt DateTime?       @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  actedAt   DateTime?       @map("acted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
  @@map("tostao_insights")
}

/// Preferências do que o Tostão acompanha automaticamente e por quais canais avisa.
model TostaoAutoConfig {
  userId          String    @id @map("user_id")
  carameloExtrato Boolean   @default(true) @map("caramelo_extrato")
  tostaoPrevisao  Boolean   @default(true) @map("tostao_previsao")
  guardiaoLimites Boolean   @default(true) @map("guardiao_limites")
  olheiroAcertos  Boolean   @default(true) @map("olheiro_acertos")
  notifyPush      Boolean   @default(true) @map("notify_push")
  notifyWhatsapp  Boolean   @default(false) @map("notify_whatsapp")
  lastCheckedAt   DateTime? @map("last_checked_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tostao_auto_configs")
}

// Anotação à mão que o app apagou sozinho quando o banco confirmou a cobrança (aparece em /anotacoes).
model ReconciledNote {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  description       String
  amountInCents     BigInt   @map("amount_in_cents")
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  categoryId        String?  @map("category_id")
  note              String?
  // Cobrança do banco que a substituiu (sem FK: ela pode ser apagada depois).
  bankTransactionId String?  @map("bank_transaction_id")
  bankDescription   String   @map("bank_description")
  reconciledAt      DateTime @default(now()) @map("reconciled_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reconciledAt])
  @@map("reconciled_notes")
}

// ---------- enums (PostgreSQL) ----------
enum OAuthProvider {
  google
  apple
}

enum ConnectionStatus {
  ACTIVE
  ERROR
}

enum AccountType {
  BANK
  CREDIT
}

enum CategoryKind {
  saida
  entrada
  neutra
}

enum ChatRole {
  user
  assistant
}

enum ChatChannel {
  app
  whatsapp
}

enum BattleKind {
  tigrinho
  urubu
}

enum BattleStatus {
  ativa
  vencida
  perdida
}

enum InsightSeverity {
  info
  warning
  urgent
}

enum InsightStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED
}
