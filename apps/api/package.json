{
  "name": "@tostao/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "sync": "tsx --env-file=.env src/jobs/run-sync-once.ts",
    "reset-link": "tsx --env-file=.env src/jobs/reset-link.ts",
    "fix-bank-dates": "tsx --env-file=.env src/jobs/fix-bank-dates.ts",
    "recompute-transfers": "tsx --env-file=.env src/jobs/recompute-internal-transfers.ts",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/jwt": "10.2.7",
    "@prisma/client": "6.19.3",
    "@tostao/contracts": "workspace:*",
    "bcryptjs": "3.0.3",
    "croner": "11.0.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
